# Salem 1692 local environment example
#
# Copy this file to .env only when you need local overrides.
# Do not commit real secrets.

# Server
PORT=2567

# Optional LiveKit voice service.
# Leave these blank to run the game without in-app voice; the UI will hide voice controls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional client overrides.
# In local dev, Vite and the server defaults already work without these values.
VITE_COLYSEUS_URL=
VITE_API_URL=
VITE_LIVEKIT_URL=
